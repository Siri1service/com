# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (Vercel & Local)
# ============================================================================

# 1. SUPABASE CREDENTIALS (ฐานข้อมูล & Auth)
# ดูได้จาก Project Settings -> API ใน Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. LINE MESSAGING API (ระบบแจ้งเตือนคำสั่งซื้อ)
# ดูได้จาก LINE Developers Console -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_ADMIN_USER_ID=your-line-user-or-group-id

# 3. SHOPEE OPEN PLATFORM API (ระบบเชื่อมโยงสินค้าและสต็อกกับ Shopee)
# ดูได้จาก Shopee Open Platform Partner Console
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key
SHOPEE_SHOP_ID=your-shopee-shop-id

# 4. GMAIL / SMTP (ระบบส่งอีเมลการตลาด)
GMAIL_USER=marketing@your-store.com
GMAIL_APP_PASSWORD=your-gmail-16-digit-app-password

# 5. THAI COURIERS LOGISTICS API (ระบบขนส่ง Flash, Thai Post, Kerry)
FLASH_EXPRESS_API_KEY=your-flash-api-key
THAI_POST_API_KEY=your-thai-post-token

